// Prisma schema for Baku Travel Guide
// Postgres (Neon, via Vercel's Storage integration) for both local dev
// and production — DATABASE_URL comes from .env locally and from the
// Vercel project's environment variables in production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tour {
  id              String   @id @default(cuid())
  slug            String   @unique
  order           Int      @default(0)
  published       Boolean  @default(true)
  imageUrl        String   @default("")
  galleryImages   String[] @default([])

  titleRu         String
  titleAz         String
  titleEn         String
  descriptionRu   String
  descriptionAz   String
  descriptionEn   String
  durationRu      String
  durationAz      String
  durationEn      String

  // Admin-entered, one item per line - e.g. "Транспорт" / "Услуги гида".
  includedRu      String @default("")
  includedAz      String @default("")
  includedEn      String @default("")
  notIncludedRu   String @default("")
  notIncludedAz   String @default("")
  notIncludedEn   String @default("")

  // Flexible per-tour pricing tiers, admin-editable, e.g.:
  // [{"minPeople":1,"maxPeople":4,"priceAzn":150,"perPerson":false},
  //  {"minPeople":5,"maxPeople":null,"priceAzn":30,"perPerson":true}]
  // maxPeople: null means "and more". perPerson: true means priceAzn is
  // per person in that range; false means priceAzn is a flat price for
  // the whole range (e.g. per car). Stored in AZN; the site converts to
  // USD/RUB for display using the exchange rates in Setting.
  priceTiers Json @default("[]")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  order     Int      @default(0)
  published Boolean  @default(true)

  textRu    String
  textAz    String
  textEn    String
  name      String
  countryRu String @default("")
  countryAz String @default("")
  countryEn String @default("")

  createdAt DateTime @default(now())
}

// Blog posts are Russian-only for now (the primary audience and the
// main SEO target) to keep writing realistic for a single admin.
model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  order       Int      @default(0)
  published   Boolean  @default(true)
  coverImageUrl String @default("")
  galleryImages String[] @default([])

  title       String
  excerpt     String
  body        String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  contact   String
  text      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// Singleton row (id is always "singleton") holding site-wide settings
// editable from the admin panel.
model Setting {
  id                String  @id @default("singleton")

  adminPasswordHash String  @default("")

  promoEnabled      Boolean @default(false)
  promoTextRu       String  @default("")
  promoTextAz       String  @default("")
  promoTextEn       String  @default("")

  // AZN per 1 unit of foreign currency, editable by admin.
  usdRate           Float   @default(1.70)
  rubRate           Float   @default(0.019)

  whatsapp          String  @default("")
  whatsapp2         String  @default("")
  telegram          String  @default("")
  phone             String  @default("")
  email             String  @default("")
  instagram         String  @default("")
  facebook          String  @default("")
  googleReviewLink  String  @default("")
}
